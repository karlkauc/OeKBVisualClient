<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude JavaFX controller classes from serialization checks -->
    <Match>
        <Package name="controller"/>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>

    <!-- Exclude generated FXML bindings -->
    <Match>
        <Bug pattern="UWF_UNWRITTEN_FIELD"/>
        <Package name="controller"/>
    </Match>

    <!-- Exclude test classes -->
    <Match>
        <Source name="~.*Test\.java"/>
    </Match>

    <!-- Singleton pattern: getInstance() intentionally returns the mutable singleton -->
    <Match>
        <Class name="model.ApplicationSettings"/>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>

    <!-- JavaFX dialog pattern: AccessRuleEditDialog intentionally shares the
         AccessRule object with its caller for editing -->
    <Match>
        <Class name="controller.AccessRuleEditDialog"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
