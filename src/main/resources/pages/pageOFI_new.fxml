<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.control.Tooltip?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.OFI"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" pannable="true"
            stylesheets="@../css/modern-theme.css">

    <content>
        <VBox styleClass="mainPane" spacing="12">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <FontIcon iconLiteral="bi-file-earmark-text" iconSize="24" iconColor="#003d5c"/>
                <Label text="OeNB Reporting" styleClass="page-title-compact"/>
            </HBox>

            <!-- Common Input Section -->
            <VBox styleClass="card-compact" spacing="10">
                <Label text="OeNB-ID eingeben:" styleClass="section-title-compact"/>
                <TextField fx:id="oenbIdField"
                           promptText="Mehrere OeNB-IDs mit Leerzeichen oder Komma trennen"/>

                <Label text="oder aus Datei laden:" styleClass="label-primary"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="selectFileButton"
                            text="Datei auswählen"
                            onAction="#selectFile"
                            styleClass="btn-info"/>
                    <Label fx:id="fileLabel" text="Keine Datei ausgewählt" styleClass="label-secondary"/>
                    <Button text="Löschen"
                            onAction="#clearFile"
                            styleClass="btn-danger"/>
                </HBox>

                <HBox spacing="20" alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label text="Datum:"/>
                        <DatePicker fx:id="datePicker" prefWidth="200.0"/>
                    </VBox>
                    <Label fx:id="statusLabel" text="Bereit" styleClass="label-secondary"/>
                </HBox>
            </VBox>

            <!-- Tabs for different OeNB modes -->
            <TabPane VBox.vgrow="ALWAYS">

                <!-- Tab 1: Aggregierung -->
                <Tab text="OeNB Aggregierung" closable="false">
                    <VBox spacing="12" style="-fx-padding: 14;">
                        <CheckBox fx:id="excludeInvalidAgg" text="Nur valide Daten (excludeinvalid)"/>

                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Button fx:id="downloadAggButton"
                                    text="Aggregierung Download"
                                    onAction="#downloadAggregierung"
                                    styleClass="btn-primary-compact">
                                <graphic>
                                    <FontIcon iconLiteral="bi-cloud-download" iconSize="14"/>
                                </graphic>
                                <tooltip>
                                    <Tooltip text="Aggregierung herunterladen"/>
                                </tooltip>
                            </Button>
                            <ProgressIndicator fx:id="progressAgg" prefWidth="30.0" prefHeight="30.0"/>
                        </HBox>

                        <VBox spacing="10" VBox.vgrow="ALWAYS">
                            <Label text="Ergebnis (XML):" styleClass="card-title-compact"/>
                            <TextArea fx:id="resultAggTextArea"
                                      VBox.vgrow="ALWAYS"
                                      prefHeight="350.0"
                                      editable="false"
                                      styleClass="result-textarea"
                                      promptText="Ergebnisse werden hier angezeigt..."/>
                        </VBox>
                    </VBox>
                </Tab>

                <!-- Tab 2: SecBySec -->
                <Tab text="OeNB SecBySec" closable="false">
                    <VBox spacing="12" style="-fx-padding: 14;">
                        <CheckBox fx:id="excludeInvalidSec" text="Nur valide Daten (excludeinvalid)"/>

                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Button fx:id="downloadSecButton"
                                    text="SecBySec Download"
                                    onAction="#downloadSecBySec"
                                    styleClass="btn-primary-compact">
                                <graphic>
                                    <FontIcon iconLiteral="bi-cloud-download" iconSize="14"/>
                                </graphic>
                                <tooltip>
                                    <Tooltip text="SecBySec herunterladen"/>
                                </tooltip>
                            </Button>
                            <ProgressIndicator fx:id="progressSec" prefWidth="30.0" prefHeight="30.0"/>
                        </HBox>

                        <VBox spacing="10" VBox.vgrow="ALWAYS">
                            <Label text="Ergebnis (XML):" styleClass="card-title-compact"/>
                            <TextArea fx:id="resultSecTextArea"
                                      VBox.vgrow="ALWAYS"
                                      prefHeight="350.0"
                                      editable="false"
                                      styleClass="result-textarea"
                                      promptText="Ergebnisse werden hier angezeigt..."/>
                        </VBox>
                    </VBox>
                </Tab>

                <!-- Tab 3: Check -->
                <Tab text="OeNB Check" closable="false">
                    <VBox spacing="12" style="-fx-padding: 14;">
                        <VBox spacing="10">
                            <Label text="Filter:" styleClass="card-title-compact"/>
                            <HBox spacing="15">
                                <RadioButton fx:id="validAll" text="Alle">
                                    <toggleGroup>
                                        <ToggleGroup fx:id="validGroup"/>
                                    </toggleGroup>
                                </RadioButton>
                                <RadioButton fx:id="validTrue" text="Nur valide" toggleGroup="$validGroup"/>
                                <RadioButton fx:id="validFalse" text="Nur invalide" toggleGroup="$validGroup"/>
                            </HBox>
                        </VBox>

                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Button fx:id="downloadCheckButton"
                                    text="Check Download"
                                    onAction="#downloadCheck"
                                    styleClass="btn-primary-compact">
                                <graphic>
                                    <FontIcon iconLiteral="bi-cloud-download" iconSize="14"/>
                                </graphic>
                                <tooltip>
                                    <Tooltip text="Check herunterladen"/>
                                </tooltip>
                            </Button>
                            <ProgressIndicator fx:id="progressCheck" prefWidth="30.0" prefHeight="30.0"/>
                        </HBox>

                        <VBox spacing="10" VBox.vgrow="ALWAYS">
                            <Label text="Ergebnis (XML):" styleClass="card-title-compact"/>
                            <TextArea fx:id="resultCheckTextArea"
                                      VBox.vgrow="ALWAYS"
                                      prefHeight="350.0"
                                      editable="false"
                                      styleClass="result-textarea"
                                      promptText="Ergebnisse werden hier angezeigt..."/>
                        </VBox>
                    </VBox>
                </Tab>

            </TabPane>

        </VBox>
    </content>
</ScrollPane>
