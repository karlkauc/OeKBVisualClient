<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AvailableData"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" pannable="true"
            stylesheets="@../css/modern-theme.css">

    <content>
        <VBox styleClass="mainPane" spacing="12">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <FontIcon iconLiteral="bi-hdd-stack-fill" iconSize="24" iconColor="#003d5c"/>
                <Label text="Verfügbare Daten abfragen" styleClass="page-title-compact"/>
            </HBox>

            <!-- Parameters Section -->
            <VBox styleClass="card-compact" spacing="10">
                <Label text="Abfrage-Parameter:" styleClass="section-title-compact"/>

                <HBox spacing="20">
                    <VBox spacing="5">
                        <Label text="Content Date (optional):" styleClass="label-primary"/>
                        <HBox spacing="5">
                            <DatePicker fx:id="contentDatePicker" prefWidth="200.0"/>
                            <Button text="Clear" onAction="#clearContentDate"
                                    styleClass="btn-secondary-compact">
                                <tooltip><Tooltip text="Content Date zurücksetzen"/></tooltip>
                            </Button>
                        </HBox>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="FDP Content Type:" styleClass="label-primary"/>
                        <ComboBox fx:id="fdpContentCombo" prefWidth="150.0"/>
                    </VBox>
                </HBox>

                <Separator/>

                <Label text="Upload-Zeitraum (nur wenn Content Date leer):" styleClass="section-title-compact"/>

                <HBox spacing="20">
                    <VBox spacing="5">
                        <Label text="Upload Date From:" styleClass="label-primary"/>
                        <DatePicker fx:id="uploadDateFromPicker" prefWidth="200.0"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Upload Date To:" styleClass="label-primary"/>
                        <DatePicker fx:id="uploadDateToPicker" prefWidth="200.0"/>
                    </VBox>
                </HBox>

                <Label fx:id="infoLabel" text="" wrapText="true" styleClass="label-secondary"/>

                <Separator/>

                <VBox spacing="5">
                    <Label text="Identifier Filter (optional):" styleClass="label-primary"/>
                    <TextField fx:id="identifierField"
                               promptText="LEI/OeNB-ID oder ISIN (mehrere durch Leerzeichen getrennt)"
                               prefWidth="700.0"/>
                </VBox>
            </VBox>

            <!-- Action Section -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button fx:id="downloadButton"
                        text="Abfrage starten"
                        onAction="#download"
                        styleClass="btn-primary-compact">
                    <graphic>
                        <FontIcon iconLiteral="bi-cloud-download" iconSize="14"/>
                    </graphic>
                    <tooltip><Tooltip text="Abfrage der verfügbaren Daten starten"/></tooltip>
                </Button>
                <ProgressIndicator fx:id="progressIndicator" prefWidth="30.0" prefHeight="30.0"/>
                <Label fx:id="statusLabel" text="Bereit" styleClass="label-secondary"/>
            </HBox>

            <!-- Result Section -->
            <VBox styleClass="card-compact" spacing="10" VBox.vgrow="ALWAYS">
                <Label text="Ergebnis (XML):" styleClass="section-title-compact"/>
                <TextArea fx:id="resultTextArea"
                          VBox.vgrow="ALWAYS"
                          prefHeight="250.0"
                          editable="false"
                          styleClass="result-textarea"
                          promptText="Ergebnisse werden hier angezeigt..."/>
            </VBox>

        </VBox>
    </content>
</ScrollPane>
